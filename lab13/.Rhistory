library(tidyverse)
library(janitor)
library(naniar)
amniota <- read_csv("data/amniota.csv") %>%
clean_names()
glimpse(amniota)
amniota <- amniota %>%
replace_with_na_all(condition = ~.x ==-999)
miss_var_summary(amniota)
summary(amniota)
amniota %>%
gg_miss_var()
amniota %>%
select(egg_mass_g, class) %>%
group_by(class) %>%
miss_var_summary()
View(amniota)
amniota %>%
distinct(class)
miss_var_summary(amniota)
summary(amniota)
amniota %>%
gg_miss_var()
