library("tidyverse")
collisions_migration_weather_spring_fall_dataset <- read.csv("collisions_migration_weather_spring_fall_dataset.csv")
View(collisions_migration_weather_spring_fall_dataset)
collisions_no_scaled <- collisions_migration_weather_spring_fall_dataset %>%
select(!(starts_with("scaled")))
View(collisions_no_scaled)
collisions_date_sep <- collisions_no_scaled %>%
separate(col="date", into = c("day","month","year"), sep = "/")
View(collisions_date_sep)
collisions_date_sep <- collisions_no_scaled %>%
separate(col="date", into = c("day","month","year"), sep = "/") %>%
select(!day)
collisions_date_sep <- collisions_no_scaled %>%
separate(col="date", into = c("day","month","year"), sep = "/") %>%
select(!day) %>%
mutate(month=as.factor(month))
glimpse(collisions_date_sep)
collisions_date_sep %>%
ggplot(aes(x=month,y=count))+
geom_histogram()
collisions_date_sep %>%
ggplot(aes(x=month,y=count))+
geom_boxplot()
