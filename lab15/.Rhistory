library(shiny)
ui <- fluidPage(
selectInput("x",
"Select fill variable",
choices = c("sex", "mating", "age_class", "denning","fasting"),
selected = "age_class"),
plotOutput("plot", width ="600px", height ="500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
polar_bears %>%
ggplot(aes(x= un_creat_ratio, y=popn, fill=input$x))+
geom_boxplot()+
theme_classic()
})
}
shinyApp(ui, server)
