polar_bears <-
read_csv("data/polarBear_serumUreaCreatinine_beaufortChukchi_rode.csv") %>%
clean_names() %>%
select(-den_method, -no_cubs, -cub_age) %>%
filter(age_class==c("A", "S")) %>%
mutate(sex=toupper(sex),
age_class=toupper(age_class))
names(polar_bears)
glimpse(polar_bears)
polar_bears <- polar_bears %>%
replace_with_na(replace = list(mating = "unknown",
denning = "unknown"))
polar_bears %>%
gg_miss_var()
polar_bears %>%
count(sex)
polar_bears %>%
count(sex) %>%
ggplot(aes(x=sex,y=n, fill=sex))+
geom_col()+
labs(y=NULL,x="Sex",title="Count of sex sampled")
polar_bears <- polar_bears %>%
separate(col="capture_date", into = c("year","month","day"), sep = "-")
counts <- bears_date_sep %>%
group_by(year) %>%
count(popn)
