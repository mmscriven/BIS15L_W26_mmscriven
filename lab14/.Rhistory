install.packages("shiny")
library("shiny")
library("tidyverse")
library("palmerpenguins")
library("janitor")
library(tidyverse)
library(janitor)
library(ggmap)
library(leaflet)
register_stadiamaps("7c5da2c8-6437-489e-b0e1-b3414bcb3b96", write = FALSE)
sharks <- read_csv("data/SharkIncidents_1950_2022_220302.csv") %>%
clean_names() %>%
filter(longitude !="NA" & latitude !="NA") %>% # pulling out NA locations
mutate(longitude = as.numeric(longitude)) # converting longitude to numeric
View(sharks)
bbox=make_bbox(c(-124.7267, -117.1467), c(32.58833, 41.56167), f=.03)
sharkmap <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom=5)
sharkmap
sharkmap <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom=5)
ggmap(sharkmap)
sharkmap <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom=6)
ggmap(sharkmap)
ggmap(sharkmap)+
geom_point(data=sharks, aes(longitude, latitude), size=.5)+
labs(x="Longitude",y="Latitude",title="Shark attacks")
sharks %>%
filter(injury=="fatal") %>%
ggmap(sharkmap)+
geom_point(aes(longitude, latitude), size=.5)+
labs(x="Longitude",y="Latitude",title="Fatal shark attacks")
fatalsharks <- sharks %>%
filter(injury=="fatal")
ggmap(sharkmap)+
geom_point(data=fatalsharks, aes(longitude, latitude), size=.5)+
labs(x="Longitude",y="Latitude",title="Fatal shark attacks")
leaflet(fatalsharks) %>%
addProviderTiles(providers$Stadia.StamenTerrain) %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
radius = 2,
stroke = F,
fillOpacity = .7
) %>%
addScaleBar(position="bottomleft") %>%
fitBounds(lng1 = -124.7267, lat1 = 32.58833,
lng2 = -117.1467, lat2 = 41.56167)
